{
	"name": "file-equinox",
	"version": "1.0.1",
	"main": "main.js",
	"productName": "File Equinox",
	"bin": {
		"file-equinox": "main.js"
	},
	"scripts": {
		"build": "npx @yao-pkg/pkg . --targets node22-win-x64 --output FileEquinox.exe",
		"start": "electron main.js",
		"pack": "electron-builder --dir",
		"dist": "electron-builder",
		"format": "prettier . --write"
	},
	"build": {
		"appId": "org.fiiidevelopment.fileequinox",
		"mac": {
			"category": "public.app-category.utilities"
		},
		"win": {
			"target": [
				"nsis",
				"portable",
				"msi"
			],
			"icon": "icons/favicon.ico"
		},
		"linux": {
			"target": [
				"AppImage",
				"snap",
				"deb"
			]
		},
		"nsis": {
			"include": "build/installer.nsh"
		},
		"msiProjectCreated": "./build/msi-hook.js"
	},
	"dependencies": {
		"express": "^4.19.2",
		"localtunnel": "^2.0.2",
		"prettier": "^3.9.5"
	},
	"description": "File sharing solution",
	"devDependencies": {
		"@semantic-release/git": "^10.0.1",
		"electron": "^43.1.0",
		"electron-builder": "^26.15.3",
		"semantic-release": "^25.0.8"
	},
	"keywords": [],
	"author": "Sprayman <sprayman1234555@gmail.com>",
	"license": "MIT",
	"type": "commonjs",
	"allowScripts": {
		"electron-winstaller@5.4.0": true
	}
}
